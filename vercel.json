{
  "headers": [
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/writings/thesis-labs-internship",
      "destination": "/writings/summer-of-hillclimbing",
      "permanent": true
    },
    {
      "source": "/writings/thesis-labs-internship/",
      "destination": "/writings/summer-of-hillclimbing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/writings/deepseek-v3-from-scratch",
      "destination": "/share/writings/deepseek-v3-from-scratch.html"
    },
    {
      "source": "/writings/deepseek-v3-from-scratch/",
      "destination": "/share/writings/deepseek-v3-from-scratch.html"
    },
    {
      "source": "/writings/summer-of-hillclimbing",
      "destination": "/share/writings/summer-of-hillclimbing.html"
    },
    {
      "source": "/writings/summer-of-hillclimbing/",
      "destination": "/share/writings/summer-of-hillclimbing.html"
    },
    {
      "source": "/projects/medical-imaging-complexity",
      "destination": "/share/projects/medical-imaging-complexity.html"
    },
    {
      "source": "/projects/medical-imaging-complexity/",
      "destination": "/share/projects/medical-imaging-complexity.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
